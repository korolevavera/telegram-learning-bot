# Скопируй этот файл в .env (убери слово example) и впиши свои значения.
# Токен бота: получи у @BotFather в Telegram
BOT_TOKEN=123456789:AAExample_token_here

# База данных. Оставь пустым для локального запуска (используется SQLite).
# На Railway этот параметр подставится автоматически плагином PostgreSQL.
DATABASE_URL=

# API-ключ FACEIT (бесплатно: developers.faceit.com). Нужен для статистики FACEIT.
FACEIT_API_KEY=
